{
  "name": "@olykov/node-red-mcp-server",
  "version": "3.5.0",
  "description": "Upstream-first Node-RED palette for exposing flows as MCP servers and tools.",
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint .",
    "check:spec": "node scripts/check-req-ids.js",
    "test": "node --unhandled-rejections=strict --test --test-timeout=30000",
    "coverage": "node --unhandled-rejections=strict --test --test-timeout=30000 --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=85 --test-coverage-exclude=test/**",
    "smoke:pack": "node --unhandled-rejections=strict scripts/pack-smoke.js",
    "prepublishOnly": "npm run lint && npm run check:spec && npm test"
  },
  "keywords": [
    "node-red",
    "mcp",
    "model-context-protocol",
    "tools",
    "server",
    "automation",
    "interactive",
    "visual-programming",
    "flow-based"
  ],
  "license": "MIT",
  "author": "Oleksii Lykov",
  "contributors": [
    "D. Edens (upstream node-red-contrib-mcp-server)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olykov/node-red-contrib-mcp-server.git"
  },
  "homepage": "https://github.com/olykov/node-red-contrib-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/olykov/node-red-contrib-mcp-server/issues"
  },
  "node-red": {
    "version": ">=5.0.0 <6.0.0",
    "nodes": {
      "nr-mcp-auth": "nr-mcp-auth.js",
      "nr-mcp-endpoint": "nr-mcp-endpoint.js",
      "nr-mcp-metrics": "nr-mcp-metrics.js",
      "nr-mcp-tool": "nr-mcp-tool.js"
    }
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "express": "^5.2.1",
    "ioredis": "^5.4.1",
    "jose": "^5.10.0"
  },
  "engines": {
    "node": ">=22.9"
  },
  "files": [
    "*.js",
    "*.html",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "lib/",
    "locales/",
    "examples/"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "node-red": "^5.0.8",
    "node-red-node-test-helper": "^0.3.6"
  },
  "overrides": {
    "@node-red/registry": {
      "npm": "11.21.1"
    }
  }
}
