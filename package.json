{
  "name": "@olykov/node-red-mcp-server",
  "version": "3.3.0",
  "description": "Upstream-first Node-RED palette for exposing flows as MCP servers and tools.",
  "main": "mcp-flow-server.js",
  "scripts": {
    "lint": "eslint .",
    "test": "node --test --test-timeout=30000",
    "coverage": "node --test --test-timeout=30000 --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=85 --test-coverage-exclude=test/**",
    "prepublishOnly": "npm run lint && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tools",
    "server",
    "automation",
    "interactive",
    "visual-programming",
    "flow-based"
  ],
  "license": "MIT",
  "author": "Oleksii Lykov",
  "contributors": [
    "D. Edens (upstream node-red-contrib-mcp-server)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olykov/node-red-contrib-mcp-server.git"
  },
  "homepage": "https://github.com/olykov/node-red-contrib-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/olykov/node-red-contrib-mcp-server/issues"
  },
  "node-red": {
    "version": ">=5.0.0",
    "nodes": {
      "mcp-auth": "mcp-auth.js",
      "mcp-flow-server": "mcp-flow-server.js",
      "mcp-server-metrics": "mcp-server-metrics.js",
      "mcp-tool-registry": "mcp-tool-registry.js"
    }
  },
  "dependencies": {
    "axios": "^1.6.0",
    "express": "^5.2.1",
    "ioredis": "^5.4.1",
    "jose": "^5.10.0",
    "node-cache": "^5.1.2"
  },
  "engines": {
    "node": ">=22.9"
  },
  "files": [
    "*.js",
    "*.html",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "lib/",
    "examples/"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  }
}
