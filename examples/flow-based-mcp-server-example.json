[
    {
        "id": "mcp-example-tab",
        "type": "tab",
        "label": "MCP flow server example",
        "disabled": false,
        "info": "One MCP endpoint with one tool implemented as a flow.\n\nBefore deploying, open **MCP example auth** and set your identity provider (issuer, client ID, client secret) and Client Hosts, and register `https://<your-host>/oauth/example-login/callback` with the provider.\n\nStorage is in memory for this example: every restart signs users out. Use Redis for real use."
    },
    {
        "id": "mcp-example-note",
        "type": "comment",
        "z": "mcp-example-tab",
        "name": "Configure MCP example auth before deploying",
        "info": "The endpoint refuses to start until the auth configuration is valid.\nTool calls arrive as `mcp-tool-execute`; the flow answers with `mcp-tool-response` and the same `executionId`.",
        "x": 220,
        "y": 40,
        "wires": []
    },
    {
        "id": "mcp-example-runtime",
        "type": "mcp-runtime",
        "name": "MCP example runtime",
        "runtimeName": "mcp-example",
        "serverPort": 8001,
        "publicBaseUrl": "",
        "adminPort": "",
        "adminEndpointPath": ""
    },
    {
        "id": "mcp-example-storage",
        "type": "mcp-redis",
        "name": "MCP example storage",
        "mode": "memory",
        "redisUrlEnv": "REDIS_URL",
        "host": "127.0.0.1",
        "port": 6379,
        "db": 0,
        "tls": false,
        "username": "",
        "passwordEnv": "",
        "keyPrefix": "mcp_auth:"
    },
    {
        "id": "mcp-example-auth",
        "type": "mcp-auth",
        "name": "MCP example auth",
        "oauthSlug": "example-login",
        "provider": "oidc",
        "issuerUrl": "https://idp.example.com",
        "clientId": "replace-with-client-id",
        "clientSecretEnv": "",
        "microsoftTenantId": "",
        "microsoftClientId": "",
        "microsoftClientSecretEnv": "",
        "allowedClientHosts": "claude.ai",
        "groupClaim": "groups",
        "userClaim": "email",
        "redis": "mcp-example-storage",
        "accessTokenTtl": 900,
        "refreshTokenTtl": 604800,
        "sessionTtl": 1814400,
        "refreshReuseGraceSeconds": 30
    },
    {
        "id": "mcp-example-server",
        "type": "mcp-flow-server",
        "z": "mcp-example-tab",
        "name": "Example endpoint",
        "runtime": "mcp-example-runtime",
        "auth": "mcp-example-auth",
        "serverName": "example",
        "serverPath": "/mcp/example",
        "allowedGroups": "",
        "x": 170,
        "y": 120,
        "wires": [
            [
                "mcp-example-route"
            ]
        ]
    },
    {
        "id": "mcp-example-tool",
        "type": "mcp-tool-registry",
        "z": "mcp-example-tab",
        "name": "Add numbers",
        "toolName": "add_numbers",
        "toolDescription": "Adds two numbers.",
        "endpoint": "mcp-example-server",
        "toolBehavior": "read",
        "worldAccess": "closed",
        "toolSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"a\": { \"type\": \"number\" },\n    \"b\": { \"type\": \"number\" }\n  },\n  \"required\": [\"a\", \"b\"]\n}",
        "outputSchema": "",
        "x": 150,
        "y": 200,
        "wires": []
    },
    {
        "id": "mcp-example-route",
        "type": "switch",
        "z": "mcp-example-tab",
        "name": "add_numbers call?",
        "property": "payload.toolName",
        "propertyType": "msg",
        "rules": [
            {
                "t": "eq",
                "v": "add_numbers",
                "vt": "str"
            }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 1,
        "x": 390,
        "y": 120,
        "wires": [
            [
                "mcp-example-add"
            ]
        ]
    },
    {
        "id": "mcp-example-add",
        "type": "function",
        "z": "mcp-example-tab",
        "name": "Add",
        "func": "const args = msg.payload.arguments || {};\nconst result = Number(args.a) + Number(args.b);\nmsg.topic = 'mcp-tool-response';\nmsg.payload = Number.isFinite(result) ?\n    { executionId: msg.payload.executionId, result: String(result) } :\n    { executionId: msg.payload.executionId, error: 'a and b must be numbers' };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 570,
        "y": 120,
        "wires": [
            [
                "mcp-example-server"
            ]
        ]
    }
]
