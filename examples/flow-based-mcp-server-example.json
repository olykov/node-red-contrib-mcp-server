[
    {
        "id": "mcp-example-tab",
        "type": "tab",
        "label": "MCP flow server example",
        "disabled": false,
        "info": "One MCP endpoint with one tool implemented as a flow.\n\nBefore deploying, set the Base URL in **MCP example runtime**, the Groups on **Example endpoint**, and open **MCP example auth** to set your identity provider (issuer, client ID, client secret) and Client Hosts, and register `https://<your-host>/oauth/example-login/callback` with the provider.\n\nStorage is in memory for this example: every restart signs users out. Use Redis for real use."
    },
    {
        "id": "mcp-example-note",
        "type": "comment",
        "z": "mcp-example-tab",
        "name": "Configure MCP example auth before deploying",
        "info": "The endpoint refuses to start until the auth configuration is valid.\nEach call leaves the MCP Tool node with the arguments in `msg.payload`; the flow puts the result in `msg.payload` and ends with MCP Tool Response.",
        "x": 220,
        "y": 40,
        "wires": []
    },
    {
        "id": "mcp-example-runtime",
        "type": "nr-mcp-runtime",
        "name": "MCP example runtime",
        "serverPort": 8001,
        "publicBaseUrl": "https://nodered.example.com",
        "adminPort": "",
        "adminEndpointPath": ""
    },
    {
        "id": "mcp-example-storage",
        "type": "nr-mcp-auth-storage",
        "name": "MCP example storage",
        "mode": "memory",
        "redisUrlEnv": "MCP_REDIS_URL",
        "host": "127.0.0.1",
        "port": 6379,
        "db": 0,
        "tls": false,
        "username": "",
        "passwordEnv": "",
        "keyPrefix": "mcp_auth:"
    },
    {
        "id": "mcp-example-auth",
        "type": "nr-mcp-auth",
        "name": "MCP example auth",
        "oauthSlug": "example-login",
        "provider": "oidc",
        "issuerUrl": "https://idp.example.com",
        "clientId": "replace-with-client-id",
        "clientSecretEnv": "",
        "microsoftTenantId": "",
        "microsoftClientId": "",
        "microsoftClientSecretEnv": "",
        "allowedClientHosts": "claude.ai",
        "groupClaim": "groups",
        "userClaim": "email",
        "redis": "mcp-example-storage",
        "accessTokenTtl": 900,
        "refreshTokenTtl": 604800,
        "sessionTtl": 1814400
    },
    {
        "id": "mcp-example-server",
        "type": "nr-mcp-endpoint",
        "name": "Example endpoint",
        "runtime": "mcp-example-runtime",
        "auth": "mcp-example-auth",
        "serverName": "example",
        "serverPath": "/mcp/example",
        "allowedGroups": "MCP.User",
        "toolTimeoutMs": 30000,
        "maxConcurrentCalls": 32
    },
    {
        "id": "mcp-example-tool",
        "type": "nr-mcp-tool",
        "z": "mcp-example-tab",
        "name": "Add numbers",
        "toolName": "add_numbers",
        "toolDescription": "Adds two numbers.",
        "scope": "endpoint",
        "endpoint": "mcp-example-server",
        "runtime": "",
        "toolBehavior": "read",
        "worldAccess": "closed",
        "toolSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"a\": { \"type\": \"number\" },\n    \"b\": { \"type\": \"number\" }\n  },\n  \"required\": [\"a\", \"b\"]\n}",
        "outputSchema": "",
        "x": 150,
        "y": 200,
        "wires": [
            [
                "mcp-example-add"
            ]
        ],
        "outputs": 1,
        "cancelOutput": false,
        "timeoutMs": 0
    },
    {
        "id": "mcp-example-add",
        "type": "function",
        "z": "mcp-example-tab",
        "name": "Add",
        "func": "const result = Number(msg.payload.a) + Number(msg.payload.b);\nif (Number.isFinite(result)) msg.payload = String(result);\nelse msg.mcp.error = 'a and b must be numbers';\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 200,
        "wires": [
            [
                "mcp-example-response"
            ]
        ]
    },
    {
        "id": "mcp-example-response",
        "type": "nr-mcp-tool-response",
        "z": "mcp-example-tab",
        "name": "",
        "x": 600,
        "y": 200,
        "wires": []
    }
]
