[
    { "id": "tab-mcp", "type": "tab", "label": "MCP" },
    { "id": "tab-tools", "type": "tab", "label": "Tools" },
    { "id": "runtime", "type": "mcp-runtime", "name": "Runtime", "runtimeName": "runtime", "serverPort": 8001,
        "bindHost": "127.0.0.1", "publicBaseUrl": "https://mcp.example.test", "adminPort": 1880,
        "adminEndpointPath": "/mcp/ops", "adminCa": "-----BEGIN CERTIFICATE-----\nexample\n-----END CERTIFICATE-----" },
    { "id": "storage", "type": "mcp-redis", "mode": "memory", "redisUrlEnv": "MCP_REDIS_URL", "keyPrefix": "mcp_auth:" },
    { "id": "auth", "type": "mcp-auth", "oauthSlug": "example-login", "provider": "oidc", "issuerUrl": "https://idp.example.test",
        "clientId": "client", "clientSecretEnv": "MCP_CLIENT_SECRET", "allowedClientHosts": "claude.ai", "redis": "storage" },
    { "id": "group-sales", "type": "group", "z": "tab-mcp", "nodes": ["endpoint-sales", "tool-list"] },
    { "id": "endpoint-ops", "type": "mcp-flow-server", "z": "tab-mcp", "runtime": "runtime", "auth": "auth",
        "serverName": "ops", "serverPath": "/mcp/ops", "allowedGroups": "Ops", "x": 100, "y": 40, "wires": [[]] },
    { "id": "endpoint-sales", "type": "mcp-flow-server", "z": "tab-mcp", "g": "group-sales", "runtime": "runtime", "auth": "auth",
        "serverName": "sales", "serverPath": "/mcp/sales", "allowedGroups": "Sales", "toolTimeoutMs": 60000,
        "maxConcurrentCalls": 8, "x": 100, "y": 120, "wires": [["calls-out"]] },
    { "id": "restart", "type": "inject", "z": "tab-mcp", "topic": "restart", "x": 80, "y": 200, "wires": [["endpoint-sales"]] },
    { "id": "calls-out", "type": "link out", "z": "tab-mcp", "mode": "link", "links": ["calls-in"], "x": 300, "y": 120 },
    { "id": "answers-in", "type": "link in", "z": "tab-mcp", "links": ["answers-out"], "x": 40, "y": 160, "wires": [["endpoint-sales"]] },
    { "id": "tool-list", "type": "mcp-tool-registry", "z": "tab-mcp", "g": "group-sales", "toolName": "list_items",
        "toolDescription": "Lists items", "endpoint": "/mcp/sales", "toolBehavior": "read", "worldAccess": "closed",
        "toolSchema": "{\"type\":\"object\",\"properties\":{}}", "outputSchema": "", "timeoutMs": 5000, "x": 100, "y": 280, "wires": [] },
    { "id": "tool-shared", "type": "mcp-tool-registry", "z": "tab-mcp", "toolName": "ping", "endpoint": "__shared__",
        "toolSchema": "{\"type\":\"object\",\"properties\":{}}", "x": 100, "y": 320, "wires": [] },
    { "id": "tool-orphan", "type": "mcp-tool-registry", "z": "tab-mcp", "toolName": "orphan", "endpoint": "/mcp/missing",
        "toolSchema": "{\"type\":\"object\",\"properties\":{}}", "x": 100, "y": 360, "wires": [] },
    { "id": "metrics", "type": "mcp-server-metrics", "z": "tab-mcp", "runtime": "runtime", "x": 100, "y": 400, "wires": [["metrics-debug"]] },
    { "id": "metrics-debug", "type": "debug", "z": "tab-mcp", "x": 300, "y": 400, "wires": [] },
    { "id": "calls-in", "type": "link in", "z": "tab-tools", "links": ["calls-out"], "x": 40, "y": 40, "wires": [["route-list"]] },
    { "id": "route-list", "type": "switch", "z": "tab-tools", "property": "payload.toolName", "propertyType": "msg",
        "rules": [{ "t": "eq", "v": "list_items", "vt": "str" }], "checkall": "true", "outputs": 1, "x": 160, "y": 40, "wires": [["list-items"]] },
    { "id": "list-items", "type": "function", "z": "tab-tools", "name": "List items",
        "func": "msg.topic = 'mcp-tool-response';\nmsg.payload = { executionId: msg.payload.executionId, result: [] };\nreturn msg;",
        "outputs": 1, "x": 320, "y": 40, "wires": [["answers-out"]] },
    { "id": "answers-out", "type": "link out", "z": "tab-tools", "mode": "link", "links": ["answers-in"], "x": 480, "y": 40 },
    { "id": "unrelated", "type": "function", "z": "tab-tools", "func": "return msg;", "outputs": 1, "x": 160, "y": 120, "wires": [[]] }
]
